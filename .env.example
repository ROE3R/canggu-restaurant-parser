# Copy this file to .env and fill in your own keys. Never commit .env.
BD_API_KEY=your_brightdata_api_key
BD_ZONE=web_unlocker1
# Optional — needed only for `python pipeline.py gofood-reviews`
# (Gojek SSO token from your own logged-in device)
GOJEK_SSO_TOKEN=
# Optional — Google Places API, for refreshing Maps data
GMAPS_API_KEY=
